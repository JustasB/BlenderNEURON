# One image recipe for all CI lanes, including the Python 2 assessment.
ARG BASE_IMAGE=python:3.13.17-slim-bookworm
FROM ${BASE_IMAGE}
# Python 2's final image uses archived Debian Buster repositories.
RUN if python -c 'import sys; sys.exit(sys.version_info[0] != 2)'; then \
      sed -i 's/deb.debian.org/archive.debian.org/g; s/security.debian.org/archive.debian.org/g; /buster-updates/d' /etc/apt/sources.list; \
    fi \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends curl xz-utils python3 xvfb xauth procps \
       openbox libgl1 libegl1 libxi6 libxrender1 libxfixes3 libxxf86vm1 \
       libxkbcommon-x11-0 libsm6 libice6 libglib2.0-0 libdbus-1-3 libasound2 \
       openmpi-bin libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*
ARG NEURON_VERSION=8.2.7
# Fail rather than silently compiling an unavailable wheel.
RUN coverage_pin=$(python -c 'import sys; print("5.5" if sys.version_info[0] == 2 else "7.10.7" if sys.version_info < (3, 10) else "7.12")') \
    && python -m pip install --no-cache-dir --only-binary=neuron "neuron==${NEURON_VERSION}" "coverage==${coverage_pin}"
RUN if python -c 'import sys; sys.exit(sys.version_info[0] != 2)'; then \
      python -m pip install --no-cache-dir future==0.18.3 pathlib2==2.3.7.post1 \
        backports.weakref==1.0.post1 monotonic==1.6 mock==3.0.5 unittest2==1.1.0 \
        subprocess32==3.5.4 backports.tempfile==1.0; \
    fi
COPY compatibility/python2_startup.py /compat-python2/sitecustomize.py
COPY install_blender.py /compat/install_blender.py
ARG BLENDER_VERSION=5.2.3
RUN python3 /compat/install_blender.py --version "${BLENDER_VERSION}" --destination /blender --coverage
COPY compatibility/integration_check.py /compat/integration_check.py
COPY compatibility/python2_assessment.py /compat/python2_assessment.py
ENV PATH=/blender:$PATH
ENV PYTHONPATH=/compat-python2:/BlenderNEURON
ENV PYTHONIOENCODING=utf-8
ENV BLENDER_USER_SCRIPTS=/tmp/blender-scripts
ENV DISPLAY=:0
ENV COVERAGE_PROCESS_START=.coveragerc
ENV BLENDERNEURON_TEST_TIMEOUT=180
ENV BLENDERNEURON_TEST_KEEP_GOING=1
WORKDIR /BlenderNEURON
CMD ["/usr/bin/python3", "/compat/integration_check.py"]
